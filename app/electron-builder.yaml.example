appId: "io.github.thomasstubblefield.hack-club-neighborhood"
productName: "Hack Club Neighborhood"
copyright: "Copyright (c) 2024 Thomas Stubblefield"
win:
  target: ["dir", "portable", "zip"]
  icon: "resources/icon.icns"
linux:
  target: ["dir", "appimage", "zip"]
  icon: "resources/icon.png"
mac:
  target: ["dir", "dmg", "zip"]
  icon: "resources/icon.icns"
  hardenedRuntime: true
  entitlements: "entitlements.plist"
  entitlementsInherit: "entitlements.plist"
  identity: "INSERT_HERE"
  gatekeeperAssess: false
  enableKeychain: false
  useCacheDirectories: true
  notarize:
    teamId: "INSERT_HERE"
    appleId: "INSERT_HERE"
    appleIdPassword: "INSERT_HERE"
